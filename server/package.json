{
  "name": "twochat-server",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime backend for TwoChat (REST + WebSocket, JSON file storage)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "smoke": "node test/smoke.mjs",
    "test:web": "node test/web-client.mjs",
    "test": "node test/smoke.mjs && node test/web-client.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
